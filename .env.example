# live = public market data, demo = synthetic offline data. Both use paper money.
DATA_MODE=live
MODEL=mock
TYPESAFE_AI_API_KEY=
# Binance USDT-M BTCUSDT perp book/flow as auxiliary Jev input (on/off). Never used for settlement.
PERP_FEATURES=on
JEV_MODEL_ID=jev-latest
# This version implements paper trading only.
TRADING_MODE=paper
HOST=127.0.0.1
PORT=3000
# sqlite = local ledger on disk (DATA_DIR); memory = no disk writes, resets on restart (hosted demo).
LEDGER=sqlite
# Hosted engine only: exact dashboard origin allowed to read the API, and whether the pause control is enabled.
# CORS_ORIGIN=https://jev-poly.vercel.app
# CONTROL=off
DATA_DIR=data/paper

# Jev call interval by time elapsed in each 5-minute round: endSecond:intervalMs, ending at 300.
# Default: 2s for 0:00-2:00, 4s for 2:00-4:00, 7s for 4:00-5:00. Set to "fixed" to use POLL_MS instead.
POLL_SCHEDULE=120:2000,240:4000,300:7000
POLL_MS=2000
MODEL_TIMEOUT_MS=3000
MAX_DATA_AGE_MS=15000
MIN_SECONDS_LEFT=30
MAX_SECONDS_LEFT=240
BANKROLL_USD=1000
TRADE_USD=10
MAX_OPEN_EXPOSURE_USD=50
# Set to off to disable the daily loss stop (paper trading only).
DAILY_LOSS_LIMIT_USD=30
MIN_EDGE=0.05
MIN_SCORE=0
MAX_SPREAD=0.06
SLIPPAGE_BUFFER=0.01
# Shrink uncalibrated Jev class scores toward 0.5. Not statistical calibration.
SCORE_WEIGHT=0.5
